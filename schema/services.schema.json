{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ProdMoh/llm-prices/schema/services.schema.json",
  "title": "Per-unit AI API prices",
  "description": "Speech, translation and document APIs billed per minute, per 1,000 characters or per page rather than per token.",
  "type": "object",
  "required": ["schema_version", "generated", "license", "services"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated": { "$ref": "#/$defs/date" },
    "license": { "const": "CC-BY-4.0" },
    "attribution": { "type": "string" },
    "repository": { "type": "string", "format": "uri" },
    "services": { "type": "array", "items": { "$ref": "#/$defs/service" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "price": {
      "type": "object", "required": ["usage_key", "per", "billed", "usd"], "additionalProperties": false,
      "properties": {
        "usage_key": { "type": "string", "minLength": 1 },
        "per": { "type": "string", "minLength": 1 },
        "billed": {
          "type": "object", "required": ["currency", "amount"], "additionalProperties": false,
          "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "amount": { "type": "number", "minimum": 0 } }
        },
        "usd": { "type": "number", "minimum": 0 }
      }
    },
    "service": {
      "type": "object", "required": ["provider", "provider_name", "model", "pricing_url", "prices"], "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "provider_name": { "type": "string" },
        "model": { "type": "string", "minLength": 1 },
        "pricing_url": { "type": "string", "format": "uri" },
        "prices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/price" } },
        "scheduled_changes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["effective", "prices"], "additionalProperties": false,
            "properties": { "effective": { "$ref": "#/$defs/date" }, "prices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/price" } } }
          }
        }
      }
    }
  }
}
